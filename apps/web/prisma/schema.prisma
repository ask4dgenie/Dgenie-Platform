// DGENIE Platform — Prisma schema
//
// Phase 0 — Foundation only. Per Architecture Spec Part Nine: "identity, the Agent
// Gateway skeleton (with only My Genie's AgentDefinition populated), the Audit Log,
// and Row-Level Security policy framework. Nothing user-facing ships in this phase."
//
// This file is the versioned source of truth for the schema (Architecture Spec Part
// Two: "Prisma's schema file is the versioned source of truth in git"). Migrations
// run via Prisma Migrate against the Supabase Postgres connection string per the
// Phase 0 kickoff brief's Step 1 ("Migration tool: Prisma Migrate, not Supabase's
// own migration system").
//
// Every model below is annotated with the Architecture Spec Part/Section or
// Blueprint it implements, per the kickoff brief's "every deliverable, cite its
// source" instruction.

// Prisma 7: the datasource block no longer carries a connection `url` (that
// moved to prisma.config.ts, for Migrate/introspection) and PrismaClient now
// requires an explicit driver adapter at runtime (see src/lib/db/prisma.ts).
// Confirmed against the actually-installed CLI (`npx prisma validate`),
// 2026-08-17 — this is a genuine 7.x breaking change from the Prisma 5/6
// pattern most training data and even some current doc-search results still
// show, so it's checked against the installed binary's own error message,
// not assumed.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// IDENTITY MODULE
// Architecture Spec Part Three: "Identity System -> `identity` -- Accounts, roles,
// parent-minor linkage, session management."
// Architecture Spec Part Four, "Identity module": User, Role, ParentLink.
// ---------------------------------------------------------------------------

/// One row per person, regardless of role. Architecture Spec Part Four: "a person
/// can hold more than one role over a lifetime, per the nine-stage Lifelong
/// Membership Journey." Auth.js (NextAuth) fields (email, emailVerified, image)
/// live on this same model per the Prisma-adapter convention, self-hosted against
/// this Postgres instance per Part Two's vendor-independence reasoning.
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?

  /// Captured at New Learner Onboarding (Architecture Spec Part Seven, Workflow 1)
  /// and drives every downstream age-gating decision, including My Genie's
  /// age-five capability floor (Part Five) and the four Deployment circles named
  /// in the Hybrid Talent Deployment Framework. Nullable because not every User
  /// (e.g. a Mentor or Administrator account) requires one at creation.
  dateOfBirth DateTime? @map("date_of_birth")

  /// Home or Membership, per Blueprint 04 Part Five. Captured at onboarding;
  /// see the `Track` enum's own doc comment for why this lives on `User`
  /// directly.
  track Track? @map("track")

  /// New Learner Onboarding's own text requires assigning a Local Learning
  /// Circle; Phase 1 Slice A left this a bare nullable id with no FK (no
  /// `circles` table existed yet). Phase 2's New Parent workflow
  /// (src/modules/community/new-parent.ts) closes that deferral directly and
  /// backfills any Phase 1-era learner still carrying a null value here. Kept
  /// as a plain id rather than upgraded to a `@relation` field, deliberately
  /// -- the authoritative record of current Circle standing is
  /// `CircleMembership` (with its own validity window); this column is a
  /// fast-lookup denormalization the assignment workflow keeps in sync, not
  /// a second source of truth.
  circleId String? @map("circle_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  roles        Role[] @relation("UserRoles")
  rolesGranted Role[] @relation("RoleGrantedBy")

  parentLinksAsParent ParentLink[] @relation("ParentLinkParent")
  parentLinksAsMinor  ParentLink[] @relation("ParentLinkMinor")

  agentInteractions AgentInteraction[]

  auditLogEntriesAsActor  AuditLogEntry[] @relation("AuditActor")
  auditLogEntriesAsTarget AuditLogEntry[] @relation("AuditTarget")

  mentorAssignmentsAsLearner  MentorAssignment[] @relation("MentorAssignmentLearner")
  mentorAssignmentsAsAssignor MentorAssignment[] @relation("MentorAssignmentAssignedBy")

  mentorSessionTranscriptsAsLearner MentorSessionTranscript[] @relation("MentorSessionTranscriptLearner")

  portfolioEntries       PortfolioEntry[]        @relation("PortfolioEntryLearner")
  lifePortfolioSnapshots LifePortfolioSnapshot[] @relation("LifePortfolioSnapshotLearner")
  geniusCycleSessions    GeniusCycleSession[]    @relation("GeniusCycleSessionLearner")

  certificationRecordsAsLearner   CertificationRecord[] @relation("CertificationRecordLearner")
  certificationRecordsAsCertifier CertificationRecord[] @relation("CertificationRecordCertifiedBy")

  genieMemory         GenieMemory?         @relation("GenieMemoryLearner")
  avatarConfiguration AvatarConfiguration? @relation("AvatarConfigurationLearner")

  verifiableParentalConsentsAsParent  VerifiableParentalConsent[] @relation("VerifiableParentalConsentParent")
  verifiableParentalConsentsAsLearner VerifiableParentalConsent[] @relation("VerifiableParentalConsentLearner")

  circleMemberships CircleMembership[] @relation("CircleMembershipUser")

  directMessagesSent     DirectMessage[] @relation("DirectMessageSender")
  directMessagesReceived DirectMessage[] @relation("DirectMessageRecipient")
  circleMessagesAuthored CircleMessage[] @relation("CircleMessageAuthor")

  morningSparksAuthored MorningSpark[] @relation("MorningSparkAuthor")

  recognitionNightsAsLearner    RecognitionNight[] @relation("RecognitionNightLearner")
  recognitionNightsAsRecognizer RecognitionNight[] @relation("RecognitionNightRecognizedBy")

  @@map("users")
}

/// Standard Auth.js (NextAuth) v5 Prisma-adapter model, current schema per
/// https://authjs.dev/getting-started/adapters/prisma (checked via Context7,
/// 2026-08-17, per Build Tooling and Connector Protocol's standing instruction
/// not to write against training-data recall for framework-specific setup).
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Auth.js (NextAuth) v5 Prisma-adapter model. See Account's doc comment.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Auth.js (NextAuth) v5 Prisma-adapter model. See Account's doc comment.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// The fifteen human roles named in Blueprint 08 Part Four, Section Five (Human
/// Architecture): Learner, Parent, Teacher, Learning Coach, Mentor, Community
/// Mentor, Administrator, Curriculum Architect, Assessment Architect, Platform
/// Architect, Founder, Volunteer, Industry Expert, Alumni, Community Partner.
/// A string-keyed enum, not a free-text field, so an invalid role assignment is a
/// schema-level impossibility, not an application-layer check that can be
/// forgotten (Architecture Spec Part Six's "deliberate redundancy" principle
/// applied one layer earlier than RLS).
enum RoleType {
  LEARNER
  PARENT
  TEACHER
  LEARNING_COACH
  MENTOR
  COMMUNITY_MENTOR
  ADMINISTRATOR
  CURRICULUM_ARCHITECT
  ASSESSMENT_ARCHITECT
  PLATFORM_ARCHITECT
  FOUNDER
  VOLUNTEER
  INDUSTRY_EXPERT
  ALUMNI
  COMMUNITY_PARTNER
}

/// A typed assignment of a User to one of the fifteen roles, WITH a validity
/// window from day one. Architecture Spec Part Four: "a person's role changes
/// over time"; kickoff brief Step 2.1: "build this to support role change from
/// day one ... retrofitting this later is exactly the mistake Part Nine's
/// phasing exists to prevent." `validTo = null` means the assignment is
/// currently active; a closed window is kept as history, never deleted or
/// overwritten, so a person's full role history (Learner -> Contributor ->
/// Mentor, per Blueprint 08 Part Four Section Three's nine-stage journey) is
/// reconstructable from this table alone.
///
/// Forward-compatibility note (Phase 0 kickoff brief, "role-model-future-
/// proofing" task): this model's own `id` is a stable primary key a future
/// `PaymentTransaction` (billing module) or `MentorPayoutCalculation`
/// (compensation module) can foreign-key onto in Phase 1 without a breaking
/// change to this table -- see Architecture Spec Part Four's Billing/
/// Compensation module notes and the Twelfth revision note.
model Role {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  roleType RoleType @map("role_type")

  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")

  /// The Administrator or Founder User who granted this assignment, per
  /// Architecture Spec Part Seven Workflow 6 (New Mentor Certification) and
  /// Workflow 1 (New Learner Onboarding, "An Administrator ... assigns a first
  /// Mentor"). Nullable to allow a Phase-0-era seed/bootstrap grant with no
  /// granting User yet on file.
  grantedByUserId String? @map("granted_by_user_id")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedByUserId], references: [id])

  agentInteractions AgentInteraction[]

  mentorAssignments             MentorAssignment[]        @relation("MentorAssignmentMentorRole")
  mentorSessionTranscripts      MentorSessionTranscript[] @relation("MentorSessionTranscriptMentorRole")
  certificationRecordsCertified CertificationRecord[]     @relation("CertificationRecordCertifiedByRole")

  @@index([userId, roleType])
  @@index([roleType, validTo])
  @@map("roles")
}

/// The consent and recovery relationship between a minor's User and a parent's
/// User, per Blueprint 12 (Parent and Family Framework) Section Three's parent
/// rights and Architecture Spec Part Two's Auth.js justification: "a parent
/// holds recovery and consent authority over a minor's account without holding
/// the account itself." A row existing and `revokedAt` null is the platform's
/// record that this parent currently holds that authority over that minor's
/// account; it does not itself store which specific rights are exercised where
/// (transparent Portfolio access, safeguarding notification, etc. -- those are
/// enforced per-table against this relationship in later phases, per Blueprint
/// 08 Part Four Section Nine's Information Architecture table).
model ParentLink {
  id String @id @default(cuid())

  parentUserId String @map("parent_user_id")
  minorUserId  String @map("minor_user_id")

  consentGrantedAt DateTime  @default(now()) @map("consent_granted_at")
  revokedAt        DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent User @relation("ParentLinkParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  minor  User @relation("ParentLinkMinor", fields: [minorUserId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, minorUserId])
  @@map("parent_links")
}

/// Home or Membership, per Blueprint 04 Part Five's Two-Track Delivery Model.
/// Captured at New Learner Onboarding (Architecture Spec Part Seven, Workflow
/// 1: "Track selection ... sets the cadence defaults used throughout
/// `learning` and `messaging`"). Lives directly on `User`, following the same
/// pattern `dateOfBirth` already established in Phase 0 -- a learner-specific
/// optional attribute on the one identity table, not a parallel profile
/// table, per this prompt's own "same conventions, not a parallel style"
/// instruction.
enum Track {
  HOME
  MEMBERSHIP
}

/// One row per run of a scheduled Mentor-learner cadence session (Weekly
/// Reflection's check-in, Architecture Spec Part Seven Workflow 3; Blueprint
/// 04 Part Thirteen). Architecture Spec Part Four: "the transcript text
/// produced by the same speech-to-text pipeline named in Part Two, session
/// date and duration, and the Role records of the two participants; no
/// reference to raw audio or video exists on this table or anywhere else."
///
/// This slice deliberately builds only the scheduling/completion shell and
/// this table -- per this prompt's own "Note for Claude Code," the live
/// WebRTC call tool is deferred pending a vendor decision (Roadmap Part 6),
/// the same "skeleton now, live integration later" pattern Phase 0 used for
/// the Agent Gateway. `transcriptText` stays null until that future work
/// wires in the real speech-to-text pipeline; nothing in this slice writes
/// to it.
enum MentorSessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

model MentorSessionTranscript {
  id String @id @default(cuid())

  learnerUserId String @map("learner_user_id")
  mentorRoleId  String @map("mentor_role_id")

  status MentorSessionStatus @default(SCHEDULED) @map("status")

  scheduledFor    DateTime  @map("scheduled_for")
  completedAt     DateTime? @map("completed_at")
  durationMinutes Int?      @map("duration_minutes")

  /// Never populated by this slice -- see the model doc comment above.
  transcriptText String? @map("transcript_text") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  learner    User @relation("MentorSessionTranscriptLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)
  mentorRole Role @relation("MentorSessionTranscriptMentorRole", fields: [mentorRoleId], references: [id])

  @@index([learnerUserId])
  @@index([mentorRoleId])
  @@map("mentor_session_transcripts")
}

/// Architecture Spec Part Seven Workflow 1: an Administrator "assigns a first
/// Mentor from available caseload capacity." Modeled with the same
/// validity-window discipline Phase 0 already applied to `Role` (`validFrom`/
/// `validTo`, never overwritten, a closed window kept as history) rather than
/// a plain mutable foreign key on the learner's record -- Blueprint 11's
/// five-year Mentor rotation (Phase 2+ operational workflow, per the Roadmap)
/// will need to reassign a learner to a new Mentor without losing the record
/// of who held that relationship before, and getting this right now avoids
/// exactly the retrofit Phase 0's own "get the data model right before the
/// feature" note warned against.
///
/// The Mentor caseload ceiling (Blueprint 11: twenty learners, combined
/// across both tracks) is enforced as a hard check at the point a new row is
/// inserted here -- both in application code (src/modules/identity/mentor-
/// assignment.ts) and, per Architecture Spec Part Six's "two layers, not
/// one," at the database layer itself: see the `mentor_assignments_insert_
/// ceiling` RLS policy in the accompanying migration, which counts existing
/// active assignments for the target Mentor's Role and refuses the insert at
/// twenty. This is a headcount query, not a payment calculation -- it does
/// not require and is not gated on the `compensation` module.
model MentorAssignment {
  id String @id @default(cuid())

  learnerUserId String @map("learner_user_id")
  mentorRoleId  String @map("mentor_role_id")

  /// The Administrator who made the assignment, per Workflow 1's own text.
  assignedByUserId String? @map("assigned_by_user_id")

  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  learner    User  @relation("MentorAssignmentLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)
  mentorRole Role  @relation("MentorAssignmentMentorRole", fields: [mentorRoleId], references: [id])
  assignedBy User? @relation("MentorAssignmentAssignedBy", fields: [assignedByUserId], references: [id])

  @@index([learnerUserId, validTo])
  @@index([mentorRoleId, validTo])
  @@map("mentor_assignments")
}

// ---------------------------------------------------------------------------
// PORTFOLIO MODULE
// Architecture Spec Part Three: "Portfolio Engine -> `portfolio` -- Assembles
// the Genius Portfolio and Life Portfolio from every other module's
// evidence." Part Four: "PortfolioEntry (the atomic unit of evidence -- one
// reflection, one submitted artifact, one certified milestone -- every other
// module writes into this table, never around it), LifePortfolioSnapshot (a
// versioned, exportable compilation ...)."
//
// Built first among this slice's new modules, per this prompt's own
// instruction: `learning` and `assessment` both write into `PortfolioEntry`
// rather than around it.
// ---------------------------------------------------------------------------

/// The three evidence kinds Part Four's own line names by example, plus a
/// fourth Blueprint 04 Part Fourteen names explicitly for the Recovery
/// Cycle: "The Genius Portfolio records the whole arc as evidence of
/// development ... a documented recovery is itself Genius Level evidence
/// under the four-tier rubric ... not a gap in the record."
enum PortfolioEntryType {
  REFLECTION
  ARTIFACT
  CERTIFIED_MILESTONE
  RECOVERY_CYCLE_RECORD
}

/// The atomic unit of evidence. Every entry belongs to exactly one learner;
/// `curriculumDomainId` and `geniusCycleSessionId` are nullable because not
/// every entry originates from a domain-scoped session (a Weekly Reflection
/// entry, for instance, is the learner's own reflection, not tied to one
/// session in `curriculumDomainId`'s sense -- see Architecture Spec Part
/// Seven Workflow 3).
model PortfolioEntry {
  id String @id @default(cuid())

  learnerUserId String             @map("learner_user_id")
  entryType     PortfolioEntryType @map("entry_type")

  curriculumDomainId   String? @map("curriculum_domain_id")
  geniusCycleSessionId String? @map("genius_cycle_session_id")

  title String

  /// Structured content: reflection text, an artifact's description and/or
  /// object-storage reference, a milestone's citation, or a Recovery Cycle
  /// arc's summary -- shape varies by `entryType`, deliberately left as JSON
  /// rather than a wide sparse table of type-specific columns, since Part
  /// Eight's portability requirement (an open, inspectable export format)
  /// cares that this is legible JSON, not that it is relationally normalized.
  content Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  learner            User                @relation("PortfolioEntryLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)
  curriculumDomain   CurriculumDomain?   @relation(fields: [curriculumDomainId], references: [id])
  geniusCycleSession GeniusCycleSession? @relation(fields: [geniusCycleSessionId], references: [id])

  certificationEvidence CertificationRecordEvidence[]

  @@index([learnerUserId])
  @@index([entryType])
  @@map("portfolio_entries")
}

/// A versioned, exportable compilation -- Architecture Spec Part One's
/// portability commitment ("the record must be portable") and Part Eight's
/// non-functional requirement ("a full LifePortfolioSnapshot export, in an
/// open format ... structured JSON plus the original media files") made
/// concrete and testable. This slice creates the table and the shape a
/// snapshot takes; per this prompt's own scope note, the actual export
/// pipeline (assembling every module's evidence, bundling media) is not this
/// slice's job -- there is little else to export yet besides `portfolio` and
/// `assessment` content.
///
/// `version` is set by application code as `(count of this learner's prior
/// snapshots) + 1`, not a database `@default(autoincrement())` -- Postgres
/// sequences are global, not scoped per learner, so a per-learner version
/// number has to be computed, not generated.
model LifePortfolioSnapshot {
  id String @id @default(cuid())

  learnerUserId String @map("learner_user_id")
  version       Int    @map("version")

  /// The compiled snapshot content itself, open-format JSON per Part Eight.
  content Json

  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  learner User @relation("LifePortfolioSnapshotLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)

  @@unique([learnerUserId, version])
  @@map("life_portfolio_snapshots")
}

// ---------------------------------------------------------------------------
// CURRICULUM MODULE
// Architecture Spec Part Three: "Curriculum Engine -> `curriculum` -- Nine
// domains, Signature Experience playbooks, locale variants." Part Four:
// "CurriculumDomain (the nine domains from Blueprint 04), Signature
// ExperiencePlaybook, each carrying a `locale` field so a French or
// Indigenous-language variant is a first-class row, not a translation
// bolted onto an English original."
// ---------------------------------------------------------------------------

/// The nine domains named in Blueprint 04 Part Two, cited from that Part
/// rather than invented. Order matches Part Two's own enumeration.
enum CurriculumDomainCode {
  SPIRITUAL_FORMATION
  INTELLECTUAL_FORMATION
  LANGUAGE_AND_COMMUNICATION
  CREATIVE_FORMATION
  LEADERSHIP_AND_SOCIETY
  TECHNOLOGY_AND_INNOVATION
  PHYSICAL_FORMATION
  EMOTIONAL_AND_SOCIAL_FORMATION
  GENIUS_DEVELOPMENT
}

/// One row per (domain, locale) pair -- a French or Indigenous-language
/// variant is "a first-class row, not a translation bolted onto an English
/// original" (Part Four), per Part Eight's internationalization requirement:
/// English, French, and the Indigenous languages Blueprint 04 Part Two names
/// are first-class locales "from the first release that touches the
/// `curriculum` ... module," which this slice is. Only Domain Nine, Genius
/// Development, is populated with real content this slice ("single domain,
/// to prove the model," per the Roadmap's own Phase 1 framing; domain
/// confirmed with Duncan directly rather than guessed) -- the other eight
/// domain codes exist in this enum because Blueprint 04 names all nine, but
/// no row for them is seeded yet.
model CurriculumDomain {
  id String @id @default(cuid())

  code   CurriculumDomainCode @map("code")
  locale String               @map("locale")

  name        String
  description String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  signatureExperiencePlaybooks SignatureExperiencePlaybook[]
  geniusCycleSessions          GeniusCycleSession[]
  geniusLevelRubrics           GeniusLevelRubric[]
  portfolioEntries             PortfolioEntry[]

  @@unique([code, locale])
  @@map("curriculum_domains")
}

/// The five Signature Experience playbook types Blueprint 04 Part Ten names
/// in full (Discovery, Builder, Innovation, Story, Kingdom Project).
/// Community Impact Project and Masterpiece Project are deliberately
/// excluded -- Part Ten states plainly that "their full playbooks ... now
/// live in Blueprint 05," out of this document's and this module's scope.
enum SignatureExperienceType {
  DISCOVERY_PROJECT
  BUILDER_PROJECT
  INNOVATION_PROJECT
  STORY_PROJECT
  KINGDOM_PROJECT
}

/// `purpose`, `structure`, and `evidenceStandard` are reproduced from
/// Blueprint 04 Part Ten's own per-type text, not paraphrased, for the
/// playbook type actually seeded this slice (Discovery Project, matched to
/// Domain Nine's own description: "personalised opportunities to develop
/// unique talents, pursue passion projects ... explore future calling").
model SignatureExperiencePlaybook {
  id String @id @default(cuid())

  curriculumDomainId String                  @map("curriculum_domain_id")
  type               SignatureExperienceType @map("type")
  locale             String                  @map("locale")

  purpose          String @db.Text
  structure        String @db.Text
  evidenceStandard String @map("evidence_standard") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  curriculumDomain CurriculumDomain @relation(fields: [curriculumDomainId], references: [id], onDelete: Cascade)

  @@unique([curriculumDomainId, type, locale])
  @@map("signature_experience_playbooks")
}

// ---------------------------------------------------------------------------
// LEARNING MODULE
// Architecture Spec Part Three: "Learning System -> `learning` -- Runs the
// Genius Cycle session state machine." Part Four: "GeniusCycleSession (one
// row per run of the seven-movement Genius Cycle from Blueprint 04), each
// session producing one or more PortfolioEntry rows on completion."
// ---------------------------------------------------------------------------

/// Blueprint 04 Part Six's own eight labeled steps, 0 through 7 ("the seven
/// movements," with movement 0 named as a companionship prelude -- modeled
/// faithfully as the full 0-7 sequence rather than resolving that naming
/// ambiguity here, per this prompt's own instruction).
enum GeniusCycleMovement {
  GENIE_CHECK_IN // 0
  AWAKEN // 1
  THINK // 2
  CREATE // 3
  LEAD_AND_SERVE // 4
  BUILD // 5
  REFLECT // 6
  GENIE_CHECK_OUT // 7
}

/// `IN_PROGRESS` moves through `GeniusCycleMovement` in order; `ABANDONED` is
/// a partial session that must never write a `PortfolioEntry` (Workflow 2's
/// own text: "Partial, abandoned sessions do not silently become evidence").
/// `IN_RECOVERY_CYCLE` / `RECOVERY_COMPLETED` are the Blueprint 04 Part
/// Fourteen branch, tracked independently via `recoveryCycleStep` below.
enum GeniusCycleSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  IN_RECOVERY_CYCLE
  RECOVERY_COMPLETED
}

/// Blueprint 04 Part Fourteen's six named Recovery Cycle steps, in order.
/// Reaching `TRY_AGAIN` is the one Recovery Cycle outcome that writes
/// `PortfolioEntry` evidence, per this prompt's own instruction ("a
/// completed cycle, or an explicit Recovery Cycle branch reaching Try
/// Again") and Part Fourteen's own text ("the Genius Portfolio records the
/// whole arc as evidence of development").
enum RecoveryCycleStep {
  TRY
  FAIL
  REFLECT
  RECOVER
  REORIENT
  TRY_AGAIN
}

/// One row per run of the Genius Cycle (Blueprint 04 Part Six) or, once
/// branched, the Recovery Cycle (Part Fourteen) it shares its shape with.
/// My Genie and the Teacher Assistant are named in Workflow 2 as "available
/// inside a session" -- per this prompt's deferred-agent boundary, this
/// model and the service functions built against it
/// (src/modules/learning/genius-cycle-session.ts) implement only the
/// session's human-only mechanics: start, movement progression, the
/// Recovery Cycle branch, completion, and evidence write. No `AgentDefinition`
/// or `AgentInteraction` reference exists on this table.
model GeniusCycleSession {
  id String @id @default(cuid())

  learnerUserId      String @map("learner_user_id")
  curriculumDomainId String @map("curriculum_domain_id")

  status          GeniusCycleSessionStatus @default(IN_PROGRESS) @map("status")
  currentMovement GeniusCycleMovement      @default(GENIE_CHECK_IN) @map("current_movement")

  /// Set only once `status` has branched to `IN_RECOVERY_CYCLE` /
  /// `RECOVERY_COMPLETED`; null for an ordinary Genius Cycle run.
  recoveryCycleStep RecoveryCycleStep? @map("recovery_cycle_step")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  abandonedAt DateTime? @map("abandoned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  learner          User             @relation("GeniusCycleSessionLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)
  curriculumDomain CurriculumDomain @relation(fields: [curriculumDomainId], references: [id])

  portfolioEntries PortfolioEntry[]

  @@index([learnerUserId, status])
  @@map("genius_cycle_sessions")
}

// ---------------------------------------------------------------------------
// ASSESSMENT MODULE
// Architecture Spec Part Three: "Assessment Engine -> `assessment` -- Applies
// Genius Level rubrics to portfolio evidence; holds certification records."
// Part Four: "GeniusLevelRubric (per domain, per level), CertificationRecord
// (who certified what, when, against which evidence -- always a human User
// as the certifying actor, never the ai-gateway module, enforced by a
// foreign key constraint that simply has no path from an AI agent to this
// table)."
// ---------------------------------------------------------------------------

/// Blueprint 04 Part Four's four Chapters, three Genius Levels each.
enum GeniusLevelChapter {
  DISCOVERY // Levels 1-3
  FOUNDATION // Levels 4-6
  MASTERY // Levels 7-9
  LEGACY // Levels 10-12
}

/// Blueprint 04 Part Twenty-Two's "Genius Level Rubric -- Four-Tier": Tier 3,
/// Proficient, is explicitly "the minimum bar required to advance a Genius
/// Level," system-wide.
enum RubricTier {
  EMERGING // Tier 1
  DEVELOPING // Tier 2
  PROFICIENT // Tier 3 -- minimum bar to advance, per Part Twenty-Two
  EXEMPLARY // Tier 4
}

/// One row per (domain, level, locale). `levelName` and `evidenceStandard`
/// are reproduced from Blueprint 04 Part Four's own per-level text (Level 1
/// "Spark" through Level 12 "Legacy Bearer"); `chapter` and `level` let a
/// query group by Chapter without re-deriving the mapping. Seeded this slice
/// for Domain Nine (Genius Development) only, matching the single domain
/// `curriculum` populates -- Part Four's own per-level text already reads as
/// domain-agnostic personal-development evidence, which is why it transfers
/// to Domain Nine directly rather than needing new domain-specific rubric
/// text invented for this slice.
model GeniusLevelRubric {
  id String @id @default(cuid())

  curriculumDomainId String             @map("curriculum_domain_id")
  level              Int                @map("level")
  chapter            GeniusLevelChapter @map("chapter")
  levelName          String             @map("level_name")
  locale             String             @map("locale")

  evidenceStandard String     @map("evidence_standard") @db.Text
  minimumTier      RubricTier @default(PROFICIENT) @map("minimum_tier")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  curriculumDomain CurriculumDomain @relation(fields: [curriculumDomainId], references: [id])

  certificationRecords CertificationRecord[]

  @@unique([curriculumDomainId, level, locale])
  @@map("genius_level_rubrics")
}

/// Architecture Spec Part Seven Workflow 4: "The agent's tool allowlist has
/// no path to write a CertificationRecord; only a human User holding the
/// correct Role can call that action, and the action requires a citation of
/// specific evidence, not a bare approval." Enforced at two levels here, per
/// Part Six's "two layers, not one":
///
/// Schema level: `certifiedByUserId` is a foreign key to `users.id` only --
/// `AgentDefinition` and `AgentInteraction` live in an entirely separate id
/// space with no relation into `User`, so there is categorically no value
/// this column could hold that resolves to an AI agent rather than a human.
/// The same "a foreign key constraint that simply has no path from an AI
/// agent" pattern Part Four names for this table, already true by
/// construction, not by a special-cased check.
///
/// Database level: the accompanying migration's `certification_records_
/// insert_mentor` RLS policy requires the inserting session's own current,
/// active Role to be MENTOR (re-resolved at write time, per Part Six's
/// dynamic-role-resolution principle, not a cached claim) and requires
/// `certifiedByUserId` to equal the actor's own id -- a Mentor cannot
/// certify "as" someone else.
///
/// The "citation of specific evidence, not a bare approval" requirement is
/// `CertificationRecordEvidence` below: application code
/// (src/modules/assessment/certify-genius-level.ts) rejects a certification
/// attempt with zero evidence rows before it ever reaches the database.
model CertificationRecord {
  id String @id @default(cuid())

  learnerUserId       String @map("learner_user_id")
  geniusLevelRubricId String @map("genius_level_rubric_id")

  certifiedByUserId String @map("certified_by_user_id")
  certifiedByRoleId String @map("certified_by_role_id")

  certifiedAt DateTime @default(now()) @map("certified_at")
  notes       String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  learner           User              @relation("CertificationRecordLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)
  geniusLevelRubric GeniusLevelRubric @relation(fields: [geniusLevelRubricId], references: [id])
  certifiedBy       User              @relation("CertificationRecordCertifiedBy", fields: [certifiedByUserId], references: [id])
  certifiedByRole   Role              @relation("CertificationRecordCertifiedByRole", fields: [certifiedByRoleId], references: [id])

  evidence CertificationRecordEvidence[]

  @@index([learnerUserId])
  @@map("certification_records")
}

/// The FK-backed evidence citation Part Seven Workflow 4 requires -- a real
/// referential-integrity link to an existing `PortfolioEntry`, not a loose
/// JSON array of ids, so a citation can never point at evidence that does
/// not (or no longer) exists. "The record itself remains defensible years
/// later when a Life Portfolio is presented to an outside institution" (Part
/// Seven Workflow 4) is a claim about referential integrity, not only about
/// prose.
model CertificationRecordEvidence {
  id String @id @default(cuid())

  certificationRecordId String @map("certification_record_id")
  portfolioEntryId      String @map("portfolio_entry_id")

  certificationRecord CertificationRecord @relation(fields: [certificationRecordId], references: [id], onDelete: Cascade)
  portfolioEntry      PortfolioEntry      @relation(fields: [portfolioEntryId], references: [id])

  @@unique([certificationRecordId, portfolioEntryId])
  @@map("certification_record_evidence")
}

// ---------------------------------------------------------------------------
// COMMUNITY MODULE -- Phase 2
// Architecture Spec Part Three: "Community System -> `community` -- Circle,
// Regional, National, Global membership." Part Four: "`Circle` (a Local
// Learning Circle), `CircleMembership`, `Region`, `NationalCommunity`,
// mirroring the seven layers of belonging without collapsing them into a
// single generic 'group' table, because the rights and workflows attached
// to a Circle and a Regional Community are genuinely different." Blueprint
// 06 Part Six names the seven layers; this module builds the third through
// sixth (Family Learning Unit is the existing ParentLink relationship, not
// a new table -- see the note on FamilyLearningUnit below; Global Community
// has no table of its own either, since Blueprint 06 describes it as "every
// DGENIE member worldwide," not a queryable grouping this module's own text
// asks it to hold membership for).
// ---------------------------------------------------------------------------

/// Blueprint 06 Part Six: "Members within a single nation, sharing civic and
/// cultural formation ... and coordinating national-level partnerships and
/// compliance." No membership table of its own -- Part Four's own module
/// text names only `Circle`, `CircleMembership`, `Region`, and
/// `NationalCommunity`; a learner's national membership is implicit through
/// their Circle's Region, not a separately tracked join, the same
/// "don't invent structure governance doesn't ask for" discipline applied
/// throughout this phase. Richer national-level tooling (partnerships,
/// compliance) is explicitly out of this phase's scope.
model NationalCommunity {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  regions Region[]

  @@map("national_communities")
}

/// Blueprint 06 Part Six: "A cluster of Local Learning Circles across a
/// state, province, or metropolitan area, connected through the monthly
/// Gathering and shared access to Community Experts." `nationalCommunityId`
/// is nullable -- a Region can exist before its national grouping is set up,
/// the same "just enough structure" scoping this phase's own instructions
/// ask for. Regional Steward tooling and the Mentor Control Tower's partial
/// build are explicitly out of this phase, per this prompt's own non-goals.
model Region {
  id   String @id @default(cuid())
  name String

  nationalCommunityId String? @map("national_community_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  nationalCommunity NationalCommunity? @relation(fields: [nationalCommunityId], references: [id])
  circles           Circle[]
  gatherings        Gathering[]

  @@map("regions")
}

/// Blueprint 06 Part Six: "A small, geographically real group of DGENIE
/// families and learners who gather weekly for Circle Time, execute
/// Community Impact Projects together, and give the digital-first community
/// an embodied, local presence." A Circle always belongs to a Region --
/// Blueprint 06's own definition of a Regional Community is a cluster of
/// Circles, so a Circle without a Region would be a layer the seven-layer
/// model doesn't describe.
model Circle {
  id   String @id @default(cuid())
  name String

  regionId String @map("region_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  region            Region             @relation(fields: [regionId], references: [id])
  memberships       CircleMembership[]
  circleTimes       CircleTime[]
  messages          CircleMessage[]
  recognitionNights RecognitionNight[]

  @@map("circles")
}

/// A member's standing in a Circle, with the same validity-window
/// discipline Phase 0 established for `Role` and Phase 1 Slice A extended
/// to `MentorAssignment`: `leftAt = null` means currently active, a closed
/// window is kept as history rather than deleted, so a family's Circle
/// history (a move, a reassignment) is reconstructable rather than
/// overwritten. Both a Parent and their linked learner(s) become members of
/// the same Circle when New Parent workflow runs -- Blueprint 06's own
/// phrasing is "families and learners," not learners alone.
model CircleMembership {
  id String @id @default(cuid())

  circleId String @map("circle_id")
  userId   String @map("user_id")

  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation("CircleMembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([circleId, leftAt])
  @@index([userId, leftAt])
  @@map("circle_memberships")
}

// ---------------------------------------------------------------------------
// MESSAGING MODULE -- remainder (Phase 2)
// Architecture Spec Part Four: "Beyond [MentorSessionTranscript, shipped in
// Phase 1], and the day-to-day text exchange the module's name implies, its
// entities are scoped tightly to Blueprint 08 Part Four's table and need no
// further elaboration here." Blueprint 08 Part Four Section Seven:
// "Communication System | Carries messages between members, mentors,
// families." Section Nine's Information Architecture table names no
// dedicated "Messages" row, deliberately not over-specified further than
// that -- these two entities are kept intentionally minimal rather than
// inventing structure (threads, reactions, read receipts beyond a single
// timestamp) governance never asks for.
// ---------------------------------------------------------------------------

/// A direct, one-to-one message between two members. Ownership follows
/// Section Nine's general Ownership and Trust framing extended to a
/// member's own authored/received communication -- visible to its sender
/// and recipient only.
model DirectMessage {
  id String @id @default(cuid())

  senderUserId    String @map("sender_user_id")
  recipientUserId String @map("recipient_user_id")

  content String @db.Text

  sentAt DateTime  @default(now()) @map("sent_at")
  readAt DateTime? @map("read_at")

  sender    User @relation("DirectMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient User @relation("DirectMessageRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([senderUserId])
  @@index([recipientUserId])
  @@map("direct_messages")
}

/// A message or announcement scoped to a Circle, visible to that Circle's
/// current membership -- "Circle-scoped messages/announcements visible to a
/// Circle's membership," per this phase's own scope. Any active Circle
/// member may post, matching Section Seven's plain "carries messages
/// between members, mentors, families," not a staff-only broadcast
/// mechanism governance never distinguishes from ordinary Circle
/// communication.
model CircleMessage {
  id String @id @default(cuid())

  circleId     String @map("circle_id")
  authorUserId String @map("author_user_id")

  content String @db.Text

  postedAt DateTime @default(now()) @map("posted_at")

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  author User   @relation("CircleMessageAuthor", fields: [authorUserId], references: [id])

  @@index([circleId])
  @@map("circle_messages")
}

// ---------------------------------------------------------------------------
// EVENTS MODULE -- four rhythms (Phase 2)
// Blueprint 06 Part Five: "Community Life." The annual rhythms (Founders'
// Day, Masterpiece Showcase, Global Gathering, Legacy Induction) are real
// per that same Part but out of this phase's scope, per this prompt's own
// non-goals and the Control Centre manifest's own task scope.
// ---------------------------------------------------------------------------

/// Blueprint 06 Part Five, "Daily rhythms": "a single short reflection,
/// question, or story shared across the global community, small enough to
/// take a minute." Staff-authored, not learner-generated, and not
/// domain-specific -- one row per calendar day, community-wide.
model MorningSpark {
  id String @id @default(cuid())

  content          String   @db.Text
  scheduledFor     DateTime @map("scheduled_for")
  authoredByUserId String   @map("authored_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  authoredBy User @relation("MorningSparkAuthor", fields: [authoredByUserId], references: [id])

  @@unique([scheduledFor])
  @@map("morning_sparks")
}

/// Shared by `CircleTime` and `Gathering` below -- both are scheduled
/// community events with the same simple lifecycle.
enum CommunityEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Blueprint 06 Part Five, "Weekly rhythms": "Every Local Learning Circle
/// gathers weekly ... for a rhythm called Circle Time: part reflection,
/// part collaborative project work, part simple fellowship." A scheduled
/// event tied to a `Circle`, not a `GeniusCycleSession` -- per this phase's
/// own instruction, deliberately distinct from the individual learning
/// state machine Phase 1 Slice A built.
model CircleTime {
  id String @id @default(cuid())

  circleId     String               @map("circle_id")
  scheduledFor DateTime             @map("scheduled_for")
  status       CommunityEventStatus @default(SCHEDULED) @map("status")
  notes        String?              @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, scheduledFor])
  @@map("circle_times")
}

/// Blueprint 06 Part Five, "Monthly rhythms": "Regional Communities ...
/// host a monthly Gathering, a live digital event connecting several Local
/// Learning Circles for shared teaching, testimony, and celebration."
model Gathering {
  id String @id @default(cuid())

  regionId     String               @map("region_id")
  scheduledFor DateTime             @map("scheduled_for")
  status       CommunityEventStatus @default(SCHEDULED) @map("status")
  title        String?
  description  String?              @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([regionId, scheduledFor])
  @@map("gatherings")
}

/// Blueprint 06 Part Five, "Monthly rhythms": "Each month closes with
/// Recognition Night, a community-wide moment honoring Genius Level
/// advancements, service completed, and character observed, never academic
/// ranking." Blueprint 08 Part Four Section Eight's own workflow table
/// confirms the shape: "Monthly Review | Mentor, Parent, Community Mentor |
/// A Recognition Night entry" -- one row per honoree per month, not a
/// wrapping event with a separate entries table. Deliberately, structurally
/// incapable of ranking: no field on this model orders, scores, or
/// compares learners against each other in any way.
enum RecognitionCategory {
  GENIUS_LEVEL_ADVANCEMENT
  SERVICE
  CHARACTER
}

model RecognitionNight {
  id String @id @default(cuid())

  learnerUserId      String              @map("learner_user_id")
  circleId           String              @map("circle_id")
  category           RecognitionCategory @map("category")
  description        String              @db.Text
  recognizedAt       DateTime            @default(now()) @map("recognized_at")
  recognizedByUserId String              @map("recognized_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  learner      User   @relation("RecognitionNightLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)
  circle       Circle @relation(fields: [circleId], references: [id])
  recognizedBy User   @relation("RecognitionNightRecognizedBy", fields: [recognizedByUserId], references: [id])

  @@index([learnerUserId])
  @@index([circleId, recognizedAt])
  @@map("recognition_nights")
}

// ---------------------------------------------------------------------------
// AI GATEWAY MODULE -- Phase 1 extension (data model only)
// Architecture Spec Part Four: "GenieMemory (My Genie's structured memory
// per learner, the source-of-truth table the pgvector index in Part Two is
// built from)."
// ---------------------------------------------------------------------------

/// Created empty for a learner at New Learner Onboarding (Architecture Spec
/// Part Seven Workflow 1: "My Genie is instantiated for the learner, its
/// GenieMemory table created empty") -- the row, not a live conversation.
/// Per this prompt's deferred-agent boundary, no content field is added here
/// beyond the row's existence and its owner: inventing a memory shape ahead
/// of the live My Genie pipeline that will actually populate it (deferred
/// pending M3, per the Roadmap) risks guessing wrong about what that future
/// slice needs. Creating the row now is the retrofit-avoidance this prompt
/// asks for; guessing its internal shape now is not.
model GenieMemory {
  id String @id @default(cuid())

  learnerUserId String @unique @map("learner_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  learner User @relation("GenieMemoryLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)

  @@map("genie_memories")
}

/// Architecture Spec Part Four names this table in full: "AvatarConfiguration
/// ... one row per learner's Genie: the currently locked set of curated 3D
/// piece IDs ... and the animation-state version in use; and voice_id ...
/// write-once, set at the Reveal and never updated by any later Season or
/// Turning process, application-layer and database-constrained against
/// modification after that first write." It did not exist in this schema
/// before this task -- Phase 0 through Phase 2 built only what each phase's
/// own scope named, and no prior phase's scope named this table. Built here
/// deliberately minimal: only `voiceId` and the columns needed to prove it
/// write-once, per this task's own instruction to build "not the whole
/// pipeline, just the gating and the middle tier's scaffolding." The curated
/// 3D piece IDs and animation-state version are real thirteen-plus-tier
/// pipeline detail (avatar rendering) this task's own non-goals exclude --
/// adding placeholder columns for them now, without the real asset/vendor
/// design that pipeline needs, would risk exactly the wrong-guess retrofit
/// this project has consistently avoided elsewhere. Extend this model when
/// the thirteen-plus tier's own pipeline slice is actually built, once its
/// separate legal briefing (`MY GENIE VOICE PIPELINE — LEGAL BRIEFING FOR
/// COUNSEL.md`) is answered.
model AvatarConfiguration {
  id String @id @default(cuid())

  learnerUserId String @unique @map("learner_user_id")

  /// Write-once, per Architecture Spec Part Four: "write-once, set at the
  /// Reveal and never updated by any later Season or Turning process,
  /// application-layer and database-constrained against modification after
  /// that first write." The consent-and-retention-scaffolding task (2026-08-
  /// 21) is the first code path that ever sets it: `activateVoiceLock`
  /// (src/modules/ai-gateway/voice-lock-activation.ts) `create()`s this row
  /// exactly once per learner -- `learnerUserId`'s own `@unique` constraint
  /// is the database-layer half of "write-once" (a second `create()` for the
  /// same learner fails on that constraint, never silently overwrites), and
  /// the accompanying RLS migration grants INSERT but never a general UPDATE
  /// for setting this column, only a narrower, Administrator-scoped UPDATE
  /// that may clear it back to null (the retention/destruction path,
  /// src/modules/ai-gateway/voice-data-retention.ts) and can never set it to
  /// a new non-null value. See that migration's own comments for the exact
  /// policies.
  voiceId      String?   @map("voice_id")
  voiceIdSetAt DateTime? @map("voice_id_set_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  learner User @relation("AvatarConfigurationLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)

  @@map("avatar_configurations")
}

/// The specific purposes a Verifiable Parental Consent record can cover.
/// One member today -- Architecture Spec Part Five, thirteen-and-up
/// paragraph (Nineteenth revision note): a consent covering the one-time
/// voice lock specifically. Modeled as an enum rather than a free-text
/// field so a future second purpose is an additive value, not a retrofit
/// of this table's shape.
enum VerifiableParentalConsentPurpose {
  VOICE_LOCK_ACTIVATION
}

/// The FTC's more rigorous consent methods, and only those -- per counsel's
/// reply of 2026-08-21 (`MY GENIE 13+ PIPELINE — FOLLOW-UP FIVE STILL-OPEN
/// QUESTIONS — LEGAL BRIEFING FOR COUNSEL.md`, Question 1): "Because the
/// voice data is disclosed to a third party (Deepgram), the lighter
/// 'email-plus'/'text-plus' methods don't qualify." This enum's own
/// membership is the structural enforcement of that exclusion, the same
/// "impossible to represent the wrong thing" pattern `RoleType` and
/// `PortfolioEntryType` already use elsewhere in this schema -- a lighter,
/// COPPA-internal-use-only method is simply not a value this column can
/// hold.
enum VerifiableParentalConsentMethod {
  KNOWLEDGE_BASED_AUTHENTICATION
  PAYMENT_CARD_TRANSACTION
  GOVERNMENT_ID_FACIAL_RECOGNITION
}

/// Records a completed Verifiable Parental Consent for the thirteen-and-up
/// tier's one-time voice lock -- Architecture Spec Part Five, thirteen-and-
/// up paragraph (Nineteenth revision note) and Blueprint 07 Part Six's
/// parallel paragraph: "Verifiable Parental Consent is required through one
/// of the more rigorous FTC-approved methods... The consent notice must
/// name that vendor, the purpose, and the retention policy."
///
/// `disclosureText` captures the exact notice text shown to the parent at
/// the moment of this specific consent, verbatim -- not a foreign key to
/// the versioned notice content in src/modules/ai-gateway/voice-lock-
/// consent-notice.ts, deliberately: a future revision to that content's
/// wording must never rewrite what a real parent was actually shown on a
/// given date, per this task's own instruction.
///
/// Append-only, the same pattern as `AuditLogEntry`: no UPDATE or DELETE
/// grant exists for `dgenie_app` on this table at all (see the accompanying
/// RLS migration) -- a consent record, once given, is never edited, only
/// superseded by a later row if a family re-consents.
model VerifiableParentalConsent {
  id String @id @default(cuid())

  parentUserId  String @map("parent_user_id")
  learnerUserId String @map("learner_user_id")

  purpose  VerifiableParentalConsentPurpose @map("purpose")
  method   VerifiableParentalConsentMethod  @map("method")
  verified Boolean                          @map("verified")

  /// Verbatim, per this model's own doc comment above.
  disclosureText String @map("disclosure_text") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  parent  User @relation("VerifiableParentalConsentParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  learner User @relation("VerifiableParentalConsentLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)

  @@index([learnerUserId, purpose])
  @@map("verifiable_parental_consents")
}

// ---------------------------------------------------------------------------
// AI GATEWAY MODULE (SKELETON)
// Architecture Spec Part Three: "AI Engine -> `ai-gateway` -- Hosts and governs
// every agent named in Blueprint 14 Section Four; see Part Five."
// Architecture Spec Part Five: the Agent Gateway pattern. Part Nine: "the Agent
// Gateway skeleton (with only My Genie's AgentDefinition populated) ... No
// working conversation, no live LLM calls yet."
// ---------------------------------------------------------------------------

/// One row per agent named in Blueprint 14 Section Four (sixteen agents total).
/// Phase 0 populates exactly one real row, My Genie (Blueprint 14 Section Four,
/// Agent One) -- every other agent is out of scope per the kickoff brief's
/// explicit non-goals. The gateway's four core responsibilities (Architecture
/// Spec Part Five) read from this row rather than a hardcoded per-agent
/// integration: resolving the AgentDefinition, assembling context only from
/// `dataScope`, exposing only `toolAllowlist`, and writing an AgentInteraction.
/// A boundary like "certification remains the Mentor's" is enforced by simply
/// never listing a certifying action in `toolAllowlist` -- a property of this
/// row's data, testable in a unit test, not a prompt instruction trusted to
/// hold.
model AgentDefinition {
  id       String @id @default(cuid())
  agentKey String @unique @map("agent_key")
  name     String

  /// Blueprint 14 Section Four's "Purpose" field, reproduced verbatim from
  /// Blueprint 08 Part Four Section Six per that Section's own note.
  purpose String @db.Text

  /// Blueprint 14 Section Four's "Human relationship" field -- which human
  /// relationship this agent augments, never replaces.
  humanRelationship String @map("human_relationship")

  /// Blueprint 14 Section Four's "Boundaries" field, made operational: the
  /// literal system prompt sent to the model. The boundary text itself still
  /// matters here (defense in depth alongside the tool allowlist below,
  /// per Architecture Spec Part Six), but Part Five is explicit that a boundary
  /// is enforced by what the gateway does NOT expose via `toolAllowlist`, not
  /// by trusting this text to be obeyed.
  systemPrompt String @map("system_prompt") @db.Text

  /// The tools this agent's Blueprint 14 boundary permits it to call. A
  /// certifying action (e.g. a hypothetical `certify_genius_level`) simply
  /// never appears here for any agent -- Architecture Spec Part Five: "the
  /// boundary is enforced by what the gateway does not expose, not by an
  /// instruction the model is trusted to obey." Empty in Phase 0 for My Genie,
  /// since no live tool-calling integration exists yet (Part Nine non-goal).
  toolAllowlist String[] @map("tool_allowlist")

  /// Blueprint 14 Section Four's "Data access" field, structured: which data
  /// sources this agent's context assembly may query. Architecture Spec Part
  /// Five: "assembling that agent's context from only the data sources
  /// Blueprint 14 Section Four names for it, never a broader query the calling
  /// module might otherwise have access to."
  dataScope Json @map("data_scope")

  /// A model identifier, not a hardcoded model call -- Architecture Spec Part
  /// Five's "Model provider independence": "replacing the underlying model ...
  /// is a configuration change ... not a rewrite of every agent's integration
  /// code."
  modelIdentifier String @map("model_identifier")

  /// Architecture Spec Part Five, "A capability floor beneath the age of
  /// five" -- revised 2026-08-20 (Fourteenth revision note) from a single
  /// gate into the first of two thresholds in a three-tier design. Below
  /// this age, My Genie's tool allowlist excludes live speech-to-text and
  /// voice-synthesis entirely; the gateway serves pre-authored content
  /// instead. Null means no floor applies to this agent. See
  /// `voiceSynthesisMinimumAge` below for the second threshold the
  /// Fourteenth revision note added.
  minimumLearnerAge Int? @map("minimum_learner_age")

  /// The second of the three-tier design's two thresholds (Architecture
  /// Spec Part Five, paragraphs following the Fourteenth/Fifteenth revision
  /// notes; Blueprint 07 Part Six). Between `minimumLearnerAge` and this
  /// age, live speech-to-text is exposed but real-time voice synthesis and
  /// the `AvatarConfiguration.voiceId` write are not -- the gateway replies
  /// in text only. At and above this age, the full pipeline applies,
  /// including the one-time voice lock. Null means this agent has no
  /// middle tier at all (every other agent besides My Genie). Two separate
  /// nullable Int fields, not one struct/enum, deliberately -- Part Five is
  /// explicit the two gates "rest on different kinds of reasoning and
  /// should not be conflated" (five is developmental, thirteen is legal,
  /// COPPA's own line for a child), so collapsing them into one tier concept
  /// at the schema level would blur a distinction the governing text is
  /// careful to keep separate. See src/modules/ai-gateway/my-genie-tool-
  /// gating.ts for the gateway logic these two fields drive.
  voiceSynthesisMinimumAge Int? @map("voice_synthesis_minimum_age")

  /// Phase 0: a configuration record, not a live integration (Part Nine).
  /// Deliberately defaulted to false -- flipping this on is a later
  /// decision, not implied by this row existing. Per the consistency
  /// decision every phase since Phase 0 has followed: every AgentDefinition
  /// row stays isActive: false until a dedicated slice activates them
  /// together, not one at a time by whichever finished first.
  isActive Boolean @default(false) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  interactions AgentInteraction[]

  @@map("agent_definitions")
}

/// Every single gateway call, logged -- Architecture Spec Part Four: "every
/// single call, logged, feeding the Audit Log in Part Ten." Part Five: "writing
/// a complete, immutable AgentInteraction record before returning a response"
/// is one of the gateway's four core responsibilities. Phase 0 creates this
/// table as a skeleton only (Part Nine); no code path writes to it yet, since
/// no live LLM call exists in this phase.
model AgentInteraction {
  id String @id @default(cuid())

  agentDefinitionId String @map("agent_definition_id")

  /// Architecture Spec Part Six: "AI agents are not a role ... every data
  /// access an agent makes is performed on behalf of a specific human's
  /// session." This is that human.
  userId String @map("user_id")

  /// The Role active at call time. Part Six: "every access check resolves the
  /// current, valid Role record at request time," not a cached claim -- this
  /// column records which one was actually current when the call was made.
  actingRoleId String? @map("acting_role_id")

  requestText  String? @map("request_text") @db.Text
  responseText String? @map("response_text") @db.Text
  toolCalls    Json?   @map("tool_calls")

  /// Architecture Spec Part Five: "Escalation is a first-class gateway
  /// behavior ... a shared escalate() capability every relevant
  /// AgentDefinition can invoke." Recorded here so an escalated interaction is
  /// findable without a separate reconciliation step.
  escalated Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  agentDefinition AgentDefinition @relation(fields: [agentDefinitionId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  actingRole      Role?           @relation(fields: [actingRoleId], references: [id])

  auditLogEntry AuditLogEntry?

  @@index([userId])
  @@index([agentDefinitionId])
  @@map("agent_interactions")
}

// ---------------------------------------------------------------------------
// AUDIT LOG
// Architecture Spec Part Ten and Part Eight: "append-only at the database
// level -- no UPDATE or DELETE grant on this table for any application role
// ... so that an audit trail cannot be quietly edited even by a compromised
// application credential." Part Ten: "the shared evidentiary base for both the
// Chief Safeguarding Officer's safeguarding audits and the Oversight Body's
// independent ... review," both reading "the same evidence the platform
// actually generated."
// ---------------------------------------------------------------------------

/// What kind of event produced this entry. AGENT_INTERACTION is the only kind
/// Phase 0's code can actually produce (and won't yet, since no live gateway
/// call exists); the remaining values are named now so the table's shape does
/// not need a breaking migration when Phase 1's workflows start writing to it
/// (e.g. CERTIFICATION_DECISION, once `CertificationRecord` exists).
enum AuditEventType {
  AGENT_INTERACTION
  ROLE_GRANTED
  ROLE_REVOKED
  PARENT_LINK_CREATED
  PARENT_LINK_REVOKED
  CERTIFICATION_DECISION
  /// Added Phase 1 Slice A, now that `MentorAssignment` exists -- a
  /// Mentor-learner relationship, including the manually seeded bootstrap
  /// cohort's assignments, is safeguarding-adjacent enough to warrant its
  /// own audit trail entry, the same reasoning already applied to role
  /// grants.
  MENTOR_ASSIGNED
  /// Added Phase 2 -- New Parent workflow's own audit trail entry (Blueprint
  /// 08 Part Four Section Eight: "produces: Family Learning Unit connected
  /// to a Local Learning Circle"), distinct from `ROLE_GRANTED` since no
  /// Role changes here.
  FAMILY_CONNECTED_TO_CIRCLE
  /// Added Phase 2 -- New Mentor Certification's own audit trail entry
  /// (Architecture Spec Part Seven, Workflow 6), distinct from the generic
  /// `ROLE_GRANTED` so the certifying office's qualifications/Teacher Creed
  /// confirmation this workflow requires is findable as its own event kind.
  MENTOR_CERTIFIED
}

/// The append-only record itself. No `updatedAt` field exists on this model,
/// deliberately -- there is no application code path that should ever revise
/// an entry, and the corresponding Postgres grants (in the accompanying
/// migration SQL) remove UPDATE and DELETE for the application role entirely,
/// enforced at the database level per Part Eight, not only by this model's own
/// shape.
model AuditLogEntry {
  id        String         @id @default(cuid())
  eventType AuditEventType @map("event_type")

  /// The human whose action or session produced this entry. Nullable only for
  /// a genuinely system-originated event (there are none yet in Phase 0).
  actorUserId String? @map("actor_user_id")

  /// Whose record this entry concerns -- e.g. the learner an AgentInteraction
  /// or a future CertificationRecord was about.
  targetUserId String? @map("target_user_id")

  agentInteractionId String? @unique @map("agent_interaction_id")

  summary  String @db.Text
  metadata Json?

  occurredAt DateTime @default(now()) @map("occurred_at")

  actor  User? @relation("AuditActor", fields: [actorUserId], references: [id])
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  agentInteraction AgentInteraction? @relation(fields: [agentInteractionId], references: [id])

  @@index([targetUserId])
  @@index([eventType])
  @@map("audit_log_entries")
}
